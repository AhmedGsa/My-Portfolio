# Visitor analytics (Telegram notifications)
# Set to true to enable tracking. Disabled by default.
VISITOR_ANALYTICS_ENABLED=true

# Telegram Bot API — create a bot via @BotFather, then get your chat id
# (message the bot, then call https://api.telegram.org/bot<token>/getUpdates)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Salt used to hash IPs (change this to a long random string)
IP_HASH_SALT=change-me-to-a-long-random-secret

# Include raw IP in the Telegram message (default true for personal monitoring)
STORE_RAW_IP=true

# Geolocation provider: "vercel" (default, free headers) or "ip-api" (adds ISP/timezone)
GEO_PROVIDER=vercel

# Only used when GEO_PROVIDER=ip-api
# IP_API_URL=http://ip-api.com/json
